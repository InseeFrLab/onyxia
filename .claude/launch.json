{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "storybook",
            "runtimeExecutable": "yarn",
            "runtimeArgs": ["--cwd", "web", "storybook", "--no-open"],
            "port": 6006
        },
        {
            "name": "web",
            "runtimeExecutable": "yarn",
            "runtimeArgs": ["--cwd", "web", "dev"],
            "port": 5173
        },
        {
            "name": "web-mock",
            "runtimeExecutable": "env",
            "runtimeArgs": [
                "ONYXIA_API_URL=",
                "yarn",
                "--cwd",
                "web",
                "dev",
                "--port",
                "5175",
                "--strictPort"
            ],
            "port": 5175
        }
    ]
}
